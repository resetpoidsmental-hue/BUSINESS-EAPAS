# URL de base de ton instance NocoDB (sans slash final)
NOCODB_URL="https://nocodb.sante-and-co.com"

# Token API NocoDB : dans NocoDB, clique sur ton avatar (en bas à gauche) >
# "Account Settings" > "Tokens" > "Create New Token"
NOCODB_API_TOKEN="colle-ton-token-ici"

# Titre exact de la base créée dans NocoDB (voir README-VITRINE.md)
NOCODB_BASE_NAME="EAPAS Vitrine"

# URL du webhook n8n qui reçoit le formulaire de contact
# (le workflow "Vitrine - Nouveau prospect" doit être activé pour que cette URL réponde)
N8N_LEAD_WEBHOOK_URL="https://n8n.srv1566455.hstgr.cloud/webhook/vitrine-contact"

# Adresse sur laquelle le site vitrine sera accessible (utilisée par docker-compose)
SITE_HOST="sante-and-co.com"

# La même adresse, en URL complète (utilisée pour le sitemap et le SEO)
SITE_URL="https://sante-and-co.com"

# Nom du réseau Docker de Traefik (le même que pour EAPAS Suite)
TRAEFIK_NETWORK="n8n_default"

# Analytics (Umami, auto-hébergé) — optionnel : laisse vide pour désactiver.
# Voir README.md section "Analytics (Umami)" pour la mise en place.
UMAMI_URL=""
UMAMI_WEBSITE_ID=""
