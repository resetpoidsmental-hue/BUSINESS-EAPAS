# En local (npm run dev) :
DATABASE_URL="file:./prisma/dev.db"

# En production avec Docker (docker-compose.yml monte un volume sur /app/data) :
# DATABASE_URL="file:/app/data/prod.db"

# Génère une valeur unique avec : openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Assistant IA (préparation de séance) : clé API Anthropic.
# https://console.anthropic.com/settings/keys — laisse vide pour désactiver
# l'Assistant IA (le reste de l'app fonctionne normalement sans).
ANTHROPIC_API_KEY=""

# L'adresse publique de l'application (utilisée pour construire les URLs de
# retour après un paiement Stripe). En production, mets ici https://<APP_HOST>.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Facturation récurrente (abonnements) — Stripe. Laisse les 3 clés vides pour
# désactiver les prélèvements automatiques (le reste de l'app fonctionne
# normalement sans). Voir le README, section "Facturation récurrente".
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Secret partagé avec la tâche cron quotidienne qui déclenche les prélèvements
# (protège /api/cron/prelevements) — génère une valeur avec : openssl rand -hex 32
CRON_SECRET=""

# Secret partagé avec le workflow n8n du site vitrine, qui crée directement le
# prospect dans l'app à la réception du formulaire de contact (protège
# /api/prospects/webhook) — génère une valeur avec : openssl rand -hex 32
N8N_WEBHOOK_SECRET=""

# Envoi des reçus de paiement par email — Resend. Laisse vide pour désactiver
# l'envoi automatique (les factures restent consultables dans l'app).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Rappels Telegram (séances à venir) + actions Annuler/Déplacer depuis Telegram.
# Laisse les 3 vides pour désactiver (le reste de l'app fonctionne normalement
# sans). Voir le README, section "Rappels Telegram".
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Secret que Telegram renvoie dans l'en-tête de chaque appel webhook — protège
# /api/telegram/webhook. Génère une valeur avec : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# Uniquement pour le déploiement Docker (docker-compose.yml) :
# L'adresse (sous-domaine) sur laquelle l'application sera accessible.
APP_HOST="suivi.ton-domaine.fr"
# Le nom du réseau Docker de ton reverse proxy existant (Traefik, etc.).
# Laisse tel quel si tu utilises le même stack n8n que dans le README.
TRAEFIK_NETWORK="n8n_default"
