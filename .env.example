# En local (npm run dev) :
DATABASE_URL="file:./prisma/dev.db"

# En production avec Docker (docker-compose.yml monte un volume sur /app/data) :
# DATABASE_URL="file:/app/data/prod.db"

# Génère une valeur unique avec : openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Assistant IA (préparation de séance) : clé API Anthropic.
# https://console.anthropic.com/settings/keys — laisse vide pour désactiver
# l'Assistant IA (le reste de l'app fonctionne normalement sans).
ANTHROPIC_API_KEY=""

# Uniquement pour le déploiement Docker (docker-compose.yml) :
# L'adresse (sous-domaine) sur laquelle l'application sera accessible.
APP_HOST="suivi.ton-domaine.fr"
# Le nom du réseau Docker de ton reverse proxy existant (Traefik, etc.).
# Laisse tel quel si tu utilises le même stack n8n que dans le README.
TRAEFIK_NETWORK="n8n_default"
